def is_balanced(s):
    stack = []
    for ch in s:
        if ch in "([{":
            stack.append(ch)
        else:
            if not stack:
                return False
            top = stack.pop()
            if (ch == ")" and top != "(") or \
               (ch == "]" and top != "[") or \
               (ch == "}" and top != "{"):
                return False
    return not stack  # ✅ Must be empty

print(is_balanced("{[()]}"))  # ✅ True
print(is_balanced("{[("))     # ✅ False
