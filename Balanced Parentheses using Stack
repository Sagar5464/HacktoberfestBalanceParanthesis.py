def is_balanced(s):
    stack = []
    for ch in s:
        if ch in "([{":
            stack.append(ch)
        else:
            if not stack:
                return False
            top = stack.pop()
            if ch == ")" and top != "(":
                return False
            elif ch == "]" and top != "[":
                return False
            elif ch == "}" and top != "{":
                return False
    return True  # ❌ Doesn’t check leftover open brackets

print(is_balanced("{[()]}"))  # Expected True
print(is_balanced("{[("))     # Expected False
